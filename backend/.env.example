APP_NAME="一麦工作台"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://oaapi.yourdomain.com

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Shanghai
LOG_CHANNEL=daily
LOG_LEVEL=warning

# 数据库（宝塔面板创建，替换为实际值）
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yimai
DB_USERNAME=yimai
DB_PASSWORD=改成强密码

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# 前端域名（Sanctum）
SANCTUM_STATEFUL_DOMAINS=oa.yourdomain.com
# Token 有效期（分钟，默认 20160 = 14 天）
SANCTUM_EXPIRATION=20160

# 随心瑜 KeepYoga（服务端持有，严禁入库）
KY_PHONE=随心瑜手机号
KY_PASSWORD=随心瑜密码

# 薪酬计算 · 人员主档（一麦工资人员系统主档_全中文_v2_20260719.xlsx）
# 值 = 该文件的**仓库外绝对路径**，例：
#   /www/wwwroot/yimai/shared/一麦工资人员系统主档_全中文_v2_20260719.xlsx
# 含员工姓名/岗位/底薪/课时费，属高敏数据 —— 勿入库、勿随包发布。
# 配好后执行：php artisan db:seed --class=PayrollProfileSeeder
# ⚠️ 不配 / 文件不存在时 seeder **只打一条 warning 就跳过**（不报错、不阻断），
#    漏配不会自己暴露 —— 部署后请确认薪酬档案数为 55，否则「薪酬计算」页是空的。
PAYROLL_MASTER_XLSX=一麦工资人员系统主档（仓库外绝对路径，含员工底薪属高敏，勿入库）

# AI 大模型代理：每账号每日生成配额（防成本滥用，默认 200）
AI_DAILY_QUOTA=200
