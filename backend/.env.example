APP_NAME="一麦工作台"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://oaapi.yourdomain.com

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=daily
LOG_LEVEL=warning

# 数据库（宝塔面板创建，替换为实际值）
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yimai
DB_USERNAME=yimai
DB_PASSWORD=改成强密码

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# 前端域名（Sanctum）
SANCTUM_STATEFUL_DOMAINS=oa.yourdomain.com

# 随心瑜 KeepYoga（服务端持有，严禁入库）
KY_PHONE=随心瑜手机号
KY_PASSWORD=随心瑜密码
