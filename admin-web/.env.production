# 【生产】环境变量（pnpm build 时自动读取）
VITE_VERSION = 3.1.19
VITE_BASE_URL = /
VITE_ACCESS_MODE = frontend

# 同域反向代理或独立API域名二选一：
# 单域名（推荐，nginx 把 /api 转发到 Laravel）：VITE_API_BASE = /api
# 双域名：VITE_API_BASE = https://oaapi.yourdomain.com/api
VITE_API_BASE = /api
VITE_USE_BACKEND = true
VITE_DROP_CONSOLE = true
