# 依赖与构建产物
node_modules/
dist/
dist-ssr/

# 本地环境与密钥（KeepYoga凭据等，严禁入库）
*.local
.env
.env.*
!.env.example
!admin-web/.env.production
# 环境变量备份文件（编辑器/脚本可能生成，同样可能含密钥）
*.env.bak
.env.backup

# 会话导出（含GitHub token等敏感信息，严禁入库）
new-session-*.json
*-session-*.json

# 日志与临时文件
*.log
logs/
.DS_Store
Thumbs.db

# 自动生成文件
.auto-import.json
admin-web/src/types/import/auto-imports.d.ts
admin-web/src/types/import/components.d.ts

# 编辑器
.idea/
.vscode/settings.json
releases/

# Framework demo content removed from the product repository
admin-web/.vite/
admin-web/src/mock/

# 随心瑜后台解读材料（截图含会员手机号等真实敏感数据，严禁入库）
随心瑜后台解读/

# AI 会话工作记忆（本地产物，不入库）
.ai-memory/

# 产品与教研规划文档（含转化策略、卡项设计、老师方法论等商业内容，本仓库为公开仓库，不入库）
docs/

# Python 缓存（脚本抽出来后可本地跑）
__pycache__/

# 在线升级的本地回滚点（update.sh 改代码前生成的代码快照 tar）。
# 属升级过程的本地中间产物，每台机器各不相同，不入库。
# 注意：update.sh 的 SITE_ROOT 默认就是脚本所在目录，在仓库内直接跑 update.sh
# 会用它 rsync 覆盖 backend/，回滚点也落在仓库里 —— 必须忽略，避免误提交。
.update-backup/

# AgentTeams 插件运行态（团队/任务/邮箱等本地产物）
.agent-teams/

# 误建的本地 SQLite 库文件（默认库是 MySQL；SQLite 仅测试用 :memory:）
backend/yimai

# ── update.sh 在本仓库内执行时会解包覆盖 backend/ 留下的发行包产物 ──────────────
# 事故记录（2026-09-21）：在仓库内执行 update.sh 后，发行包内容被 rsync 进 backend/，
# 覆盖了尚未提交的工作区代码（t41 的业绩机制代码被删），并留下下列「源码仓库本不该有」
# 的产物。已用 git checkout HEAD -- 恢复代码；这里补忽略以防再次误提交。
# 真正的教训：**不要在仓库内直接跑 update.sh**（SITE_ROOT 默认为脚本所在目录）。
backend/CHANGELOG.md
backend/version.json
backend/public/config.js
backend/public/index.html
backend/public/assets/
